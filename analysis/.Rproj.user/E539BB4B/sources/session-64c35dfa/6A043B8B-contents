# --- Global Ignore Rules ---
# Ensure .DS_Store is ignored globally across all directories
.DS_Store

# 1. Ignore everything
*

# 2. But, un-ignore this .gitignore file itself
!.gitignore

# 3. Un-ignore the project file metadata
!.Rproj.user/
!*.Rproj

# 4. Un-ignore the 'analysis' folder AND everything in it
!analysis/
!analysis/**

# 5. Un-ignore the 'data' folder AND everything in it
!data/
!data/**

# 6. Un-ignore the NEW 'annotated' folder AND everything in it
!annotated/
!annotated/**